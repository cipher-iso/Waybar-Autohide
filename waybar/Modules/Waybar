#!/usr/bin/env bash

shopt -s nocasematch
set -- "${@,,}"

LOCKED="$HOME/.config/waybar/Modules/.Locked"
VISIBLE="$HOME/.config/waybar/Modules/.Visible"
CONFIG="$HOME/.config/waybar/config.jsonc"
POLL=0.10

# [ AUTO-SHOW PERCENTAGE ]
ENTRY=1
# [ AUTO-HIDE PERCENTAGE ]
EXIT=10
# [ SHOW WHEN # TILED WINDOWS ]
MIN_TILED=99

# [ GREP FUNCTIONS ]
cursor(){ hyprctl cursorpos; }
resolution(){ hyprctl -j monitors | jq -r '.[] | select(.focused==true) | "\(.width)x\(.height)"'; }
position(){ grep -m1 '"position"' "$CONFIG" | sed -E 's/.*"position":[[:space:]]*"([^"]+)".*/\1/'; }

# [ TILED WINDOWS IDENTIFIER ]
tiled(){ local ws=$(hyprctl activeworkspace | awk '/workspace ID/ {print $3}'); hyprctl clients | awk -v ws="$ws" '
        /^Window /{cur_ws="";floating=""}
        /^\s*workspace:/{cur_ws=$2}
        /^\s*floating:/{floating=$2}
        cur_ws==ws && floating==0 {count++;cur_ws=""}
        END{print count+0}'; }

# [ SPECIAL WORKSPACE IDENTIFIER ]
special(){ hyprctl monitors | awk '
        BEGIN {focused=0; special=-1}
        /^Monitor / {focused=0; special=-1}
        /focused: yes/ {focused=1}
        /special workspace:/ {special=$3}
        END {exit !(focused==1 && special != -1 && special != 0)}'; }

# [ RELOAD WAYBAR ]
reload(){
    killall waybar swayosd-server swaync 2>/dev/null
    waybar >/dev/null 2>&1 &
    swayosd-server >/dev/null 2>&1 &
    swaync >/dev/null 2>&1 &

    while ! pgrep -x waybar >/dev/null; do sleep 0.05; done
    sleep 0.3
    pkill -fi "Waybar AutoHide" 2>/dev/null

    if [[ -f "$LOCKED" ]]; then
        pkill -SIGUSR2 waybar
    else
        pkill -SIGUSR1 waybar
        nohup Waybar AutoHide >/dev/null 2>&1 &
    fi
}

# [ TOGGLE WAYBAR VISIBILITY ]
toggle(){
    if pgrep -fi "Waybar AutoHide" >/dev/null; then
        pkill -fi "Waybar AutoHide" 2>/dev/null
        pkill -SIGUSR1 waybar
        rm -f "$VISIBLE"
    else
        if [ -f "$VISIBLE" ]; then
            pkill -SIGUSR1 waybar
            rm -f "$VISIBLE"
        else
            pkill -SIGUSR2 waybar
            touch "$VISIBLE"
            if [ ! -f "$LOCKED" ]; then nohup Waybar AutoHide >/dev/null 2>&1 & fi
        fi
    fi
}

# [ AUTO-HIDE WAYBAR ]
autohide(){
    bar_visible=false
    while true; do
        CURSOR=$(cursor)
        IFS=',' read -r X Y <<< "$CURSOR"
        RES=$(resolution)
        WIDTH=${RES%x*}
        HEIGHT=${RES#*x}
        POSITION=$(position)
        tiled_count=$(tiled)
        if special; then special_flag=1; else special_flag=0; fi

        case "$POSITION" in
            top)
                EDGE1=$(( HEIGHT * ENTRY / 100 ))
                EDGE2=$(( HEIGHT * EXIT / 100 ))
                SHOW_CONDITION=$(( Y <= EDGE1 ))
                HIDE_CONDITION=$(( Y > EDGE2 ))
                ;;
            bottom)
                EDGE1=$(( HEIGHT * (100 - ENTRY) / 100 ))
                EDGE2=$(( HEIGHT * (100 - EXIT) / 100 ))
                SHOW_CONDITION=$(( Y >= EDGE1 ))
                HIDE_CONDITION=$(( Y < EDGE2 ))
                ;;
            left)
                EDGE1=$(( WIDTH * ENTRY / 100 ))
                EDGE2=$(( WIDTH * EXIT / 100 ))
                SHOW_CONDITION=$(( X <= EDGE1 ))
                HIDE_CONDITION=$(( X > EDGE2 ))
                ;;
            right)
                EDGE1=$(( WIDTH * (100 - ENTRY) / 100 ))
                EDGE2=$(( WIDTH * (100 - EXIT) / 100 ))
                SHOW_CONDITION=$(( X >= EDGE1 ))
                HIDE_CONDITION=$(( X < EDGE2 ))
                ;;
            *)
                EDGE1=$(( HEIGHT * ENTRY / 100 ))
                EDGE2=$(( HEIGHT * EXIT / 100 ))
                SHOW_CONDITION=$(( Y <= EDGE1 ))
                HIDE_CONDITION=$(( Y > EDGE2 ))
                ;;
        esac

	if (( special_flag || tiled_count==0 || tiled_count>=MIN_TILED || (tiled_count<MIN_TILED && SHOW_CONDITION) )); then
            if ! $bar_visible; then
                pkill -SIGUSR2 waybar
                touch "$VISIBLE"
                bar_visible=true
            fi
        elif (( tiled_count < MIN_TILED && HIDE_CONDITION )); then
            if $bar_visible; then
                pkill -SIGUSR1 waybar
                rm -f "$VISIBLE"
                bar_visible=false
            fi
        fi
        sleep "$POLL"
    done
}

# [ LOCK/UNLOCK WAYBAR ]
lock(){
    if [ -f "$LOCKED" ]; then
        # UNLOCK
        rm "$LOCKED"
        pkill -SIGUSR2 waybar
        touch "$VISIBLE"

        (
            bar_visible=true
            while true; do
                tiled_count=$(tiled)
                special_flag=0
                if special; then special_flag=1; fi

                if (( tiled_count == 1 && special_flag == 0 )); then
                    CURSOR=$(cursor)
                    IFS=',' read -r X Y <<< "$CURSOR"
                    RES=$(resolution)
                    WIDTH=${RES%x*}
                    HEIGHT=${RES#*x}
                    POSITION=$(position)

                    case "$POSITION" in
                        top)
                            EDGE2=$(( HEIGHT * EXIT / 100 ))
                            HIDE_CONDITION=$(( Y > EDGE2 ))
                            ;;
                        bottom)
                            EDGE2=$(( HEIGHT * (100 - EXIT) / 100 ))
                            HIDE_CONDITION=$(( Y < EDGE2 ))
                            ;;
                        left)
                            EDGE2=$(( WIDTH * EXIT / 100 ))
                            HIDE_CONDITION=$(( X > EDGE2 ))
                            ;;
                        right)
                            EDGE2=$(( WIDTH * (100 - EXIT) / 100 ))
                            HIDE_CONDITION=$(( X < EDGE2 ))
                            ;;
                        *)
                            EDGE2=$(( HEIGHT * EXIT / 100 ))
                            HIDE_CONDITION=$(( Y > EDGE2 ))
                            ;;
                    esac

                    if (( HIDE_CONDITION )); then
                        pkill -SIGUSR1 waybar
                        rm -f "$VISIBLE"
                        bar_visible=false
                        nohup Waybar AutoHide >/dev/null 2>&1 &
                        break
                    fi
                fi
                sleep "$POLL"
            done
        ) &
    else
        # LOCK
        touch "$LOCKED"
        pkill -fi "Waybar AutoHide" 2>/dev/null
        pkill -SIGUSR2 waybar
        pkill -fi "Waybar Lock" 2>/dev/null
    fi
}

# [ WAYBAR MODULE ]
module(){
    if [ -f "$LOCKED" ]; then
        printf '{"text":"","tooltip":"[ TASKBAR LOCKED ]"}\n'
    else
        printf '{"text":"","tooltip":"[ TASKBAR UNLOCKED ]"}\n'
    fi
}

# [ AVAILABLE INPUTS ]
case "${1,,}" in
    toggle) toggle ;;
    module) module ;;
    unlock|lock) lock ;;
    autohide) autohide ;;
    *) reload ;;
esac
